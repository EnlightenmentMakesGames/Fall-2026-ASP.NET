@model BlogWithEf.Models.Post
@{
    ViewData["Title"] = "Delete";
}
<h1>Delete Post</h1>
<div class="alert alert-warning">Are you sure you want to delete this post?</div>
<dl class="row">
    <dt class="col-sm-2">Title</dt><dd class="col-sm-10">@Model.Title</dd>
    <dt class="col-sm-2">Created</dt><dd class="col-sm-10">@Model.CreatedUtc.ToLocalTime()</dd>
</dl>
<form asp-action="Delete">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>